# Sonia Studio environment variables
# Never commit real API keys to GitHub.

# Gemini is not currently used by the app.
GEMINI_API_KEY=""

# Local development URL. Replace with your Netlify URL after deployment.
APP_URL="http://localhost:3000"

# Resend email delivery.
# Add the real key in Netlify Site configuration → Environment variables.
RESEND_API_KEY=""

# Safe Resend test sender. For production, use a sender on your verified domain.
EMAIL_FROM="Sonia Studio <onboarding@resend.dev>"

# Telegram Bot API delivery.
# Copy the real token from @BotFather in Netlify Site configuration.
TELEGRAM_BOT_TOKEN=""
